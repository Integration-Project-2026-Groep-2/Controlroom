<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:complexType name="WatchdogError">
        <xs:sequence>
            <xs:element name="service" type="xs:string"/>
            <xs:element name="errors" type="WatchdogErrorData" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="WatchdogErrorData">
        <xs:sequence>
            <xs:element name="timestamp" type="xs:dateTime"/>
            <xs:element name="issue" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>
</xs:schema>
