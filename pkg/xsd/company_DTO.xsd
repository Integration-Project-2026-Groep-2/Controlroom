        <xs:complexType>
            <xs:sequence>
                <xs:element name="id"          type="UUIDType"/>
                <xs:element name="confirmedAt" type="ISO8601DateTimeType"/>
                <xs:element name="indexed" type="xs:dateTime"/>
            </xs:sequence>
        </xs:complexType>
  </xs:element>
</xs:schema>